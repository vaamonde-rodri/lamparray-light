[Desktop Entry]
Type=Application
Name=Keyboard Lighting
Name[de]=Tastaturbeleuchtung
Name[es]=Iluminación del teclado
Name[fr]=Éclairage du clavier
Name[it]=Illuminazione della tastiera
Name[ja]=キーボードライティング
Name[pt]=Iluminação do teclado
Name[ru]=Подсветка клавиатуры
Name[zh_CN]=键盘灯光
Comment=Color, effects and brightness of the keyboard backlight
Comment[de]=Farbe, Effekte und Helligkeit der Tastaturbeleuchtung
Comment[es]=Color, efectos e intensidad de la retroiluminación del teclado
Comment[fr]=Couleur, effets et luminosité du rétroéclairage du clavier
Comment[it]=Colore, effetti e luminosità della retroilluminazione della tastiera
Comment[ja]=キーボードバックライトの色・エフェクト・明るさ
Comment[pt]=Cor, efeitos e brilho da luz de fundo do teclado
Comment[ru]=Цвет, эффекты и яркость подсветки клавиатуры
Comment[zh_CN]=键盘背光的颜色、效果和亮度
Exec=@BINDIR@/kbd-light
Icon=input-keyboard
Terminal=false
Categories=Settings;HardwareSettings;GTK;
Keywords=keyboard;rgb;light;lighting;backlight;lamparray;
Keywords[de]=Tastatur;RGB;Licht;Beleuchtung;Hintergrundbeleuchtung;
Keywords[es]=teclado;rgb;luz;iluminación;retroiluminación;
Keywords[fr]=clavier;rgb;lumière;éclairage;rétroéclairage;
Keywords[it]=tastiera;rgb;luce;illuminazione;retroilluminazione;
Keywords[ja]=キーボード;RGB;ライト;バックライト;
Keywords[pt]=teclado;rgb;luz;iluminação;
Keywords[ru]=клавиатура;rgb;свет;подсветка;
Keywords[zh_CN]=键盘;RGB;灯光;背光;
StartupNotify=true
