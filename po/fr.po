#: src/kbd_light.py:21
msgid ""
"Usage:\n"
"  kbd-light                       open the application\n"
"  kbd-light info                  list the detected LampArray devices\n"
"  kbd-light color RRGGBB [0-100]  static color and brightness (%)\n"
"  kbd-light effect NAME [1-10]    effect and speed. Effects: static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         second color (for \"alternate\")\n"
"  kbd-light auto                  hand control back to the firmware (Fn + ↑/↓)\n"
"  kbd-light off                   turn the lighting off\n"
"  kbd-light restore               apply the last saved settings\n"
"  kbd-light daemon                run the background service (effects, login, resume)\n"
msgstr ""
"Utilisation :\n"
"  kbd-light                       ouvre l’application\n"
"  kbd-light info                  liste les appareils LampArray détectés\n"
"  kbd-light color RRGGBB [0-100]  couleur fixe et luminosité (%)\n"
"  kbd-light effect NAME [1-10]    effet et vitesse. Effets : static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         seconde couleur (pour « alternate »)\n"
"  kbd-light auto                  rend le contrôle au firmware (Fn + ↑/↓)\n"
"  kbd-light off                   éteint l’éclairage\n"
"  kbd-light restore               applique les derniers réglages enregistrés\n"
"  kbd-light daemon                lance le service en arrière-plan (effets, connexion, reprise)\n"

