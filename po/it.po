#: src/kbd_light.py:21
msgid ""
"Usage:\n"
"  kbd-light                       open the application\n"
"  kbd-light info                  list the detected LampArray devices\n"
"  kbd-light color RRGGBB [0-100]  static color and brightness (%)\n"
"  kbd-light effect NAME [1-10]    effect and speed. Effects: static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         second color (for \"alternate\")\n"
"  kbd-light auto                  hand control back to the firmware (Fn + ↑/↓)\n"
"  kbd-light off                   turn the lighting off\n"
"  kbd-light restore               apply the last saved settings\n"
"  kbd-light daemon                run the background service (effects, login, resume)\n"
msgstr ""
"Uso:\n"
"  kbd-light                       apre l’applicazione\n"
"  kbd-light info                  elenca i dispositivi LampArray rilevati\n"
"  kbd-light color RRGGBB [0-100]  colore fisso e luminosità (%)\n"
"  kbd-light effect NAME [1-10]    effetto e velocità. Effetti: static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         secondo colore (per \"alternate\")\n"
"  kbd-light auto                  restituisce il controllo al firmware (Fn + ↑/↓)\n"
"  kbd-light off                   spegne l’illuminazione\n"
"  kbd-light restore               applica le ultime impostazioni salvate\n"
"  kbd-light daemon                avvia il servizio in background (effetti, accesso, ripresa)\n"

