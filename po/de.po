#: src/kbd_light.py:21
msgid ""
"Usage:\n"
"  kbd-light                       open the application\n"
"  kbd-light info                  list the detected LampArray devices\n"
"  kbd-light color RRGGBB [0-100]  static color and brightness (%)\n"
"  kbd-light effect NAME [1-10]    effect and speed. Effects: static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         second color (for \"alternate\")\n"
"  kbd-light auto                  hand control back to the firmware (Fn + ↑/↓)\n"
"  kbd-light off                   turn the lighting off\n"
"  kbd-light restore               apply the last saved settings\n"
"  kbd-light daemon                run the background service (effects, login, resume)\n"
msgstr ""
"Verwendung:\n"
"  kbd-light                       öffnet die Anwendung\n"
"  kbd-light info                  listet die erkannten LampArray-Geräte auf\n"
"  kbd-light color RRGGBB [0-100]  feste Farbe und Helligkeit (%)\n"
"  kbd-light effect NAME [1-10]    Effekt und Geschwindigkeit. Effekte: static, breathing,\n"
"                     rainbow, alternate, heartbeat, candle, aurora, strobe, cputemp\n"
"  kbd-light color2 RRGGBB         zweite Farbe (für „alternate“)\n"
"  kbd-light auto                  gibt die Steuerung an die Firmware zurück (Fn + ↑/↓)\n"
"  kbd-light off                   schaltet die Beleuchtung aus\n"
"  kbd-light restore               wendet die zuletzt gespeicherten Einstellungen an\n"
"  kbd-light daemon                startet den Hintergrunddienst (Effekte, Anmeldung, Fortsetzen)\n"

